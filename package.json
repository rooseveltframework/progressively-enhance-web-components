  "version": "2.0.0",
  "homepage": "https://rooseveltframework.org/docs/progressively-enhance-web-components/latest",
  "license": "CC-BY-4.0",
  "main": "progressively-enhance-web-components.js",
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "js-beautify": "2.0.3",
    "jsdom": "30.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "standard": "17.1.2"
  },
  "standard": {
    "ignore": [
      "dist/",
      "playwright-report/",
      "sampleApps/express/public",
      "test-results/"
    ]
  },
  "scripts": {
    "lint": "standard",
    "lint-fix": "standard --fix",
    "test": "npm run test-node && npm run test-browser",
    "test-node": "node --test test/test.js",
    "test-browser": "playwright test",
    "coverage": "node --test --experimental-test-coverage test/test.js",
    "express-sample": "node -e \"process.chdir('sampleApps/express'); require('./sampleApps/express/server.js')\"",
    "sample": "npm run express-sample"
  },
  "repository": {
    "type": "git",
    "url": "git://github.com/rooseveltframework/progressively-enhance-web-components.git"
  },
  "keywords": [
    "progressively enhance",
    "progressively",
    "enhance",
    "progressive enhancement",
    "progressive",
    "enhancement",
    "web components",
    "web",
    "components",
    "custom elements",
